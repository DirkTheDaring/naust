[Unit]
Description=naust OCI/Docker registry
Documentation=https://docs.docker.com/registry/spec/api/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/naust
ExecStart=/usr/bin/naust --config /etc/naust/registry.core.toml --config /etc/naust/registry.auth.toml $REGISTRY_RUST_ARGS server
Restart=on-failure
RestartSec=2s

# Avoid EMFILE ("Too many open files") under concurrent pushes/pulls.
# Connections and open blob files both consume file descriptors.
LimitNOFILE=65536

# Run as a dedicated system user.
User=registry
Group=registry

# Create and manage the writable state directory.
StateDirectory=naust
StateDirectoryMode=0750
WorkingDirectory=/var/lib/naust

# Basic hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

# Allow reading config, writing state.
ReadOnlyPaths=/etc/naust
ReadWritePaths=/var/lib/naust

[Install]
WantedBy=multi-user.target
