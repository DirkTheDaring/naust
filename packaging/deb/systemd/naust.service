[Unit]
Description=naust OCI registry
Documentation=man:naust(1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=registry
Group=registry

EnvironmentFile=-/etc/default/naust

# Allow admins to pass extra args/config overlays.
ExecStart=/usr/bin/naust --config /etc/naust/registry.core.toml --config /etc/naust/registry.auth.toml $REGISTRY_RUST_ARGS server

WorkingDirectory=/var/lib/naust
StateDirectory=naust
StateDirectoryMode=0750

Restart=on-failure
RestartSec=2
TimeoutStopSec=30

# Avoid EMFILE ("Too many open files") under concurrent pushes/pulls
# (aligned with the RPM unit, KI-21).
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/naust
ReadOnlyPaths=/etc/naust

[Install]
WantedBy=multi-user.target
